# Copy to .env and fill in. Never commit the real .env.

# --- General ---
COMPOSE_PROJECT_NAME=fleetpulse
TENANT_DEFAULT=demo

# --- Postgres (3NF core + pgvector) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fleetpulse
POSTGRES_USER=fleetpulse
POSTGRES_PASSWORD=changeme
# Host-reachable, for db/postgres/seed_fleet.py running outside compose.
# Port 5434, not 5432: a native Windows PostgreSQL service already holds 5432
# on this dev machine, shadowing Docker's forward.
POSTGRES_HOST_EXTERNAL=localhost
POSTGRES_PORT_EXTERNAL=5434

# --- TimescaleDB (separate instance, telemetry) ---
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=telemetry
TIMESCALE_USER=fleetpulse
TIMESCALE_PASSWORD=changeme
TIMESCALE_HOST_EXTERNAL=localhost
TIMESCALE_PORT_EXTERNAL=5433

# --- MongoDB (twin docs + raw archive) ---
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=fleetpulse
MONGO_ROOT_USER=fleetpulse
MONGO_ROOT_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Garage (S3-compatible lake; MinIO CE was deprecated, see PROGRESS.md) ---
# Internal (container-to-container) endpoint uses Garage's S3 API port 3900,
# not the host-mapped 9000. Fixed dev-only keypair, imported (not randomly
# generated) via `garage key import` in infra/compose/garage-provision.sh /
# `make lake-init` (session 4), so Flink's S3 plugin config and this file
# always agree without a manual copy-paste step. Garage enforces its own key
# format (access key: "GK" + 24 hex chars; secret: 64 hex chars) — these
# aren't free-form like the old MinIO env vars were. Rotate for anything
# beyond a local POC.
MINIO_BUCKET=fleetpulse-lake
MINIO_ENDPOINT=http://minio:3900
GARAGE_ACCESS_KEY=GKdeadbeefdeadbeefdeadbeef
GARAGE_SECRET_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# --- Kafka (KRaft) + Schema Registry ---
KAFKA_BROKERS=kafka:9092
# Host-reachable listener (see docker-compose.yml's kafka.EXTERNAL listener) —
# used by tools run outside compose, e.g. services/simulator/bench_ingest.py.
KAFKA_BROKERS_EXTERNAL=localhost:29092
SCHEMA_REGISTRY_URL=http://schema-registry:8080/apis/registry/v2

# --- Mosquitto (MQTT 5, mTLS) ---
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_CA_CERT=infra/certs/ca/ca.crt
# The simulator runs on the host (not in compose), so it connects via the
# published port using the host-reachable name, not the in-network one above.
MQTT_HOST_EXTERNAL=localhost
# Vehicles are grouped into VIN-hash shards, one mTLS client cert per shard
# (100K live per-device certs isn't a one-session build) — see
# infra/certs/issue-shard-certs.py and libs/fleetcore/algorithms/sharding.py.
MQTT_SHARD_COUNT=32

# --- Keycloak ---
KEYCLOAK_HOST=keycloak
# 8080 in-network (the image's default listen port); host-published as 8082
# (docker-compose.yml — 8081 was already taken by flink-jobmanager).
KEYCLOAK_INTERNAL_PORT=8080
KEYCLOAK_PORT_EXTERNAL=8082
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_REALM=fleetpulse

# --- API (session 6: FastAPI + SQLModel) ---
API_PORT=8000
# NOSUPERUSER NOBYPASSRLS (migration 005) so RLS actually applies to the API,
# unlike POSTGRES_USER above, which is a superuser docker creates by default.
API_DB_USER=fleetpulse_api
API_DB_PASSWORD=changeme
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_PER_MINUTE=60

# --- Claude / copilot (profile: ai) ---
ANTHROPIC_API_KEY=

# --- Observability (profile: obs) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_PASSWORD=changeme
