# FleetPulse web (PLAN §6.3 session 7). Vite only exposes VITE_-prefixed vars
# to client code — none of these are secret, they're all public OIDC client
# config (the fleetpulse-web Keycloak client is a public client, no secret).
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8082
VITE_KEYCLOAK_REALM=fleetpulse
VITE_KEYCLOAK_CLIENT_ID=fleetpulse-web
